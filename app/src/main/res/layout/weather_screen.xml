<?xml version="1.0" encoding="utf-8"?>
<!-- Clock and the weather on black over a slow ambient glow (WeatherScene). 1080p TVs are 960x540 dp. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="840dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top: clock and date on the left, the weather now on the right. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="#E6FFFFFF"
                    android:textSize="96sp"
                    android:fontFamily="@font/outfit_extralight"
                    android:letterSpacing="-0.04"
                    android:includeFontPadding="false" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginStart="4dp"
                    android:format12Hour="@string/date_format"
                    android:format24Hour="@string/date_format"
                    android:textColor="#8CFFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="@font/outfit_regular"
                    android:letterSpacing="0.14"
                    android:textAllCaps="true" />

                <!-- Today's sunrise and sunset, under the date: the left column is shorter than the weather
                     block on the right, so this fills that space without moving the hours and days down. -->
                <LinearLayout
                    android:id="@+id/sun"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_w_sunrise"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/sunrise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="#B3FFFFFF"
                        android:textSize="16sp"
                        android:fontFamily="@font/outfit_regular"
                        android:letterSpacing="0.04" />

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="28dp"
                        android:src="@drawable/ic_w_sunset"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/sunset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="#B3FFFFFF"
                        android:textSize="16sp"
                        android:fontFamily="@font/outfit_regular"
                        android:letterSpacing="0.04" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/nowIcon"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/nowTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textColor="#F2FFFFFF"
                        android:textSize="72sp"
                        android:fontFamily="@font/outfit_light"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/nowText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D9FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="@font/outfit_regular" />

                <TextView
                    android:id="@+id/nowDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#99FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/outfit_regular"
                    android:letterSpacing="0.03" />

                <TextView
                    android:id="@+id/nowSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#66FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit_medium"
                    android:letterSpacing="0.12"
                    android:textAllCaps="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- IMGW warnings for the powiat; gone when there are none. -->
        <TextView
            android:id="@+id/warnings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/warning_pill"
            android:textColor="#FFFFD27A"
            android:textSize="14sp"
            android:fontFamily="@font/outfit_medium"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/hours_title"
            android:textColor="#73FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.22"
            android:textAllCaps="true" />

        <!-- The next 12 hours, filled by WeatherScene. -->
        <LinearLayout
            android:id="@+id/hours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/days_title"
            android:textColor="#73FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.22"
            android:textAllCaps="true" />

        <!-- The next 5 days, filled by WeatherScene. -->
        <LinearLayout
            android:id="@+id/days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/sources"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/sources"
            android:textColor="#4DFFFFFF"
            android:textSize="10sp"
            android:fontFamily="@font/outfit_regular"
            android:letterSpacing="0.06" />
    </LinearLayout>
</FrameLayout>
